---
import Icon from "@/components/Icon.astro";
import { broadcasts } from "@/data/site";
---

<ul class="broadcasts" aria-label="Broadcast credits">
  {
    broadcasts.map((broadcast, index) => (
      <li>
        <a
          class="broadcast"
          href={broadcast.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${broadcast.show} on ${broadcast.platform} (opens in a new tab)`}
        >
          <span class="broadcast__index">{String(index + 1).padStart(2, "0")}</span>
          <span class="broadcast__show">{broadcast.show}</span>
          <span class="broadcast__platform">
            <Icon name={broadcast.platform === "Twitch" ? "twitch" : "youtube"} size={13} />
            {broadcast.platform}
          </span>
          <Icon name="arrow-up-right" size={14} class="broadcast__arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .broadcasts {
    border-top: 1px solid var(--line);
  }

  .broadcast {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto 1.2rem;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0.6rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s var(--ease), padding-left 0.3s var(--ease);
  }

  .broadcast:hover {
    padding-left: 1rem;
    background: var(--surface);
  }

  .broadcast__index {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.03em;
  }

  .broadcast__show {
    font-size: 1rem;
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .broadcast__platform {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
  }

  .broadcast__arrow {
    color: var(--muted);
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .broadcast:hover .broadcast__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 420px) {
    .broadcast {
      grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    }

    .broadcast__arrow {
      display: none;
    }
  }
</style>
