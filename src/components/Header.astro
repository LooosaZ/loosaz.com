---
import Icon from "@/components/Icon.astro";
import { nav, site } from "@/data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <a class="logo" href="/" aria-label={`${site.name} — home`}>
      <span class="logo__mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="logo__word">loosaz</span>
    </a>

    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item, index) => (
            <li>
              <a
                class:list={["nav__link", { "is-active": isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                <span class="nav__index" aria-hidden="true">0{index + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav__extra">
        <p class="nav__extra-label">Let's build something</p>
        <a class="btn btn--accent" href="mailto:contact@loosaz.com">
          contact@loosaz.com
          <Icon name="arrow-up-right" size={16} />
        </a>
        <div class="nav__meta">
          <span class="availability"><span class="availability__dot"></span>{site.availability}</span>
        </div>
      </div>
    </nav>

    <div class="header__actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Switch to dark theme"
        title="Switch to dark theme"
      >
        <span class="theme-toggle__icon theme-toggle__moon">
          <Icon name="moon" size={17} />
        </span>
        <span class="theme-toggle__icon theme-toggle__sun">
          <Icon name="sun" size={17} />
        </span>
      </button>

      <a class="btn btn--sm header__cta" href="/contact">
        Let's talk
        <Icon name="arrow-up-right" size={15} />
      </a>

      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="nav-toggle__icon nav-toggle__open">
          <Icon name="menu" size={20} />
        </span>
        <span class="nav-toggle__icon nav-toggle__close">
          <Icon name="close" size={20} />
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: var(--header-bg);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header {
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
    }
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 40px -32px rgba(0, 0, 0, 0.5);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    margin-right: auto;
    z-index: 2;
  }

  .logo__mark {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    gap: 2px;
    width: 12px;
    padding: 0;
    transform: rotate(-8deg);
    transition: transform 0.4s var(--ease);
  }

  .logo:hover .logo__mark {
    transform: rotate(0deg) scale(1.08);
  }

  .logo__mark span {
    width: 5px;
    height: 5px;
    background: var(--ink);
    border-radius: 1px;
  }

  .logo__mark span:nth-child(2) {
    background: var(--accent);
  }

  .logo__mark span:nth-child(3) {
    opacity: 0.35;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.25s var(--ease), background-color 0.25s var(--ease);
  }

  .nav__index {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--accent-text);
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.25s var(--ease);
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .nav__link.is-active {
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .nav__link.is-active .nav__index {
    opacity: 1;
  }

  .nav__extra {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .theme-toggle,
  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .theme-toggle:hover,
  .nav-toggle:hover {
    background: var(--surface);
    border-color: var(--line-strong);
    transform: translateY(-1px);
  }

  .theme-toggle__icon,
  .nav-toggle__icon {
    display: inline-grid;
    place-items: center;
  }

  .theme-toggle__sun,
  .nav-toggle__close {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: inline-grid;
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 900px) {
    .header__cta {
      display: none;
    }

    .nav-toggle {
      display: inline-grid;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      max-height: calc(100svh - 4.5rem);
      overflow-y: auto;
      padding: 2.25rem max(1.25rem, calc((100vw - var(--container)) / 2)) 2.5rem;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
      box-shadow: var(--shadow);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.75rem);
      pointer-events: none;
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease),
        visibility 0.3s var(--ease);
    }

    .site-header.is-nav-open .nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .site-header.is-nav-open .nav-toggle__open {
      display: none;
    }

    .site-header.is-nav-open .nav-toggle__close {
      display: block;
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__link {
      display: flex;
      align-items: baseline;
      justify-content: flex-start;
      gap: 0.75rem;
      padding: 1rem 0;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      font-size: clamp(1.75rem, 7vw, 2.4rem);
      font-weight: 500;
      letter-spacing: -0.04em;
      color: var(--ink);
      line-height: 1.1;
    }

    .nav__link:hover {
      background: transparent;
      color: var(--accent-text);
    }

    .nav__link.is-active {
      background: transparent;
      box-shadow: none;
    }

    .nav__index {
      opacity: 1;
      font-size: 0.625rem;
    }

    .nav__extra {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .nav__extra-label {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .nav__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      color: var(--muted);
    }
  }

  @media (min-width: 901px) {
    .nav {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .availability__dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2f9e44;
  }

  .availability__dot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid #2f9e44;
    opacity: 0.45;
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(0.8);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .availability__dot::after {
      animation: none;
    }
  }
</style>
