---
import Icon from "@/components/Icon.astro";
import { partners } from "@/data/site";
---

<ul class="partners" aria-label="Partners">
  {
    partners.map((partner) => (
      <li>
        <a
          class="partner"
          href={partner.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${partner.name} (opens in a new tab)`}
        >
          <span class="partner__logo">
            <img src={partner.logo} alt="" width="56" height="56" loading="lazy" decoding="async" />
          </span>
          <span class="partner__name">{partner.name}</span>
          <Icon name="arrow-up-right" size={13} class="partner__arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .partner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .partner:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  .partner__logo {
    position: relative;
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg-deep);
  }

  .partner__logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(0.9);
    opacity: 0.72;
    transition: filter 0.4s var(--ease), opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  .partner:hover .partner__logo img {
    filter: none;
    opacity: 1;
    transform: scale(1.05);
  }

  .partner__name {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .partner__arrow {
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    color: var(--muted);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .partner {
    position: relative;
  }

  .partner:hover .partner__arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .partners {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .partners {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .partner:last-child {
      grid-column: span 2;
      flex-direction: row;
      align-items: center;
    }

    .partner:last-child .partner__name {
      margin-top: 0;
    }
  }
</style>
