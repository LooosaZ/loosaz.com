---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import TechStack from "@/components/TechStack.astro";
import PartnerRow from "@/components/PartnerRow.astro";
import BroadcastList from "@/components/BroadcastList.astro";
import ContactCta from "@/components/ContactCta.astro";
import { site, socials } from "@/data/site";

const profileSocials = socials.filter((social) => social.icon !== "mail");

const timeline = [
  {
    label: "Early 2022",
    title: "First lines of code",
    body: "I started programming in early 2022, mostly by breaking things and reading docs. That self-taught habit never really left.",
  },
  {
    label: "Now",
    title: "Broadcast & community",
    body: "Freelance Global Broadcast Manager for esports and entertainment, working with teams like Riot Games, Blizzard, SehLoiro, Ostra Content and Raidiant.",
  },
  {
    label: "Studies",
    title: "Cybersecurity @ UTC",
    body: "Studied at UTC, learning how systems fail — and how to keep them from failing.",
  },
  {
    label: "For fun",
    title: "Minecraft mods & side quests",
    body: "Java mods for TortuguitaSMP, Discord themes and small tools. If something can be tweaked, automated or made a little nicer, I'll probably try.",
  },
];

const pillars = [
  {
    icon: "radio",
    title: "Broadcast",
    body: "Global broadcast management for esports and entertainment — keeping shows moving, teams aligned and the stream on air.",
  },
  {
    icon: "code",
    title: "Build",
    body: "Open-source projects, Minecraft Java mods and websites. I like useful things with a bit of personality.",
  },
  {
    icon: "sparkle",
    title: "Community",
    body: "Community moderation with Grupo SehLoiro and Riot Games. Keeping spaces welcoming and conversations on track.",
  },
];
---

<BaseLayout
  title="About"
  description="Meet LoosaZ — a freelance Global Broadcast Manager, cybersecurity graduate from UTC and self-taught developer."
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <p class="eyebrow">About me</p>
      <h1>A producer who <em>codes.</em></h1>
      <p class="lead">
        I'm LoosaZ — a freelance Global Broadcast Manager for esports and
        entertainment, a cybersecurity graduate, and a self-taught developer who
        can't leave things alone.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="intro-title">
    <div class="container about-intro">
      <div class="intro-copy" data-reveal>
        <h2 id="intro-title" class="sr-only">The short version</h2>
        <p>
          My path into tech wasn't a straight line. I started programming in early
          2022 because I wanted to understand how the things I used every day were
          made. One tutorial turned into a Minecraft mod, then a website, then a
          rabbit hole of languages and frameworks I wanted to try.
        </p>
        <p>
          Around the same time, I was spending a lot of time around esports
          communities. That eventually turned into broadcast work — managing shows,
          coordinating with teams and making sure everything that should happen on
          air actually does. Today I do that freelance for esports and entertainment
          clients.
        </p>
        <p>
          I also studied cybersecurity at <strong>UTC</strong>. I like understanding
          how systems work under the hood: the same curiosity that gets me into
          modding is the one that gets me into security.
        </p>
        <p>
          This site is where I keep the things I'm proud of — the shows I've worked
          on, the projects I've shipped and the tools I keep coming back to.
        </p>
      </div>

      <aside class="profile-card" data-reveal style="--reveal-delay:100ms">
        <div class="profile-card__head">
          <img
            src="/assets/avatar.jpg"
            alt="LoosaZ's pixel-art avatar"
            width="76"
            height="76"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="profile-card__name">LoosaZ</p>
            <p class="profile-card__role">Global Broadcast Manager</p>
          </div>
        </div>

        <dl class="profile-card__facts">
          <div>
            <dt>Education</dt>
            <dd>Cybersecurity @ UTC</dd>
          </div>
          <div>
            <dt>Coding since</dt>
            <dd>2022</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Broadcast & community</dd>
          </div>
          <div>
            <dt>Currently</dt>
            <dd>{site.availability}</dd>
          </div>
        </dl>

        <div class="profile-card__socials">
          <span>Elsewhere</span>
          <ul>
            {
              profileSocials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="me noopener noreferrer"
                    aria-label={social.name}
                    title={social.name}
                  >
                    <Icon name={social.icon} size={15} />
                  </a>
                </li>
              ))
            }
            <li>
              <a href={`mailto:${site.email}`} aria-label="Email" title="Email">
                <Icon name="mail" size={15} />
              </a>
            </li>
          </ul>
        </div>

        <a class="btn btn--sm profile-card__cta" href="/contact">
          Get in touch
          <Icon name="arrow-up-right" size={14} />
        </a>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="container timeline-layout">
      <div class="timeline-intro">
        <p class="eyebrow">The path</p>
        <h2 id="timeline-title">A few <em>turning points.</em></h2>
        <p>Not a straight line, but a fun one to look back on.</p>
      </div>

      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline__item">
              <span class="timeline__label">{item.label}</span>
              <div class="timeline__body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="pillars-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">What I do</p>
          <h2 id="pillars-title" class="section-head__title">
            Three lanes, one <em>brain.</em>
          </h2>
        </div>
        <div class="section-head__aside">
          <p>
            Broadcast, code and community overlap more than you'd think. All three
            are about timing, communication and caring about the details.
          </p>
        </div>
      </div>

      <div class="pillars">
        {
          pillars.map((pillar, index) => (
            <article class="pillar" data-reveal style={`--reveal-delay:${index * 70}ms`}>
              <div class="pillar__top">
                <span class="pillar__icon">
                  <Icon name={pillar.icon} size={18} />
                </span>
                <span class="pillar__index">0{index + 1}</span>
              </div>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stack-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Tech stack</p>
          <h2 id="stack-title" class="section-head__title">
            Tools I keep <em>coming back to.</em>
          </h2>
        </div>
        <div class="section-head__aside">
          <p>
            I'm not loyal to a stack — I pick what fits the problem. These are the
            ones that show up most often, from small scripts to full websites.
          </p>
        </div>
      </div>
      <TechStack />
    </div>
  </section>

  <section class="section" aria-labelledby="credits-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">On air</p>
          <h2 id="credits-title" class="section-head__title">
            Broadcast <em>credits.</em>
          </h2>
        </div>
        <div class="section-head__aside">
          <p>
            Shows and channels I've helped take live on Twitch as a Global Broadcast
            Manager.
          </p>
        </div>
      </div>
      <BroadcastList />

      <div class="partners-block">
        <div class="partners-block__head">
          <h3>Partners & collaborators</h3>
          <span class="mono">05</span>
        </div>
        <PartnerRow />
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* Intro ----------------------------------------------------------------- */

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .intro-copy p {
    color: var(--muted);
    font-size: 1.0125rem;
    line-height: 1.75;
  }

  .intro-copy p + p {
    margin-top: 1.1rem;
  }

  .intro-copy p strong {
    color: var(--ink);
    font-weight: 500;
  }

  .intro-copy p:first-of-type::first-letter {
    float: left;
    margin: 0.04em 0.12em 0 0;
    color: var(--accent-text);
    font-size: 3.2em;
    font-weight: 600;
    line-height: 0.82;
  }

  .profile-card {
    position: sticky;
    top: 6.5rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .profile-card__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .profile-card__head img {
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 0.85rem;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .profile-card__name {
    font-size: 1.15rem;
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .profile-card__role {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .profile-card__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding-block: 0.5rem;
  }

  .profile-card__facts > div {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
  }

  .profile-card__facts dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .profile-card__facts dd {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .profile-card__socials {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1rem;
  }

  .profile-card__socials > span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .profile-card__socials ul {
    display: flex;
    gap: 0.3rem;
  }

  .profile-card__socials a {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .profile-card__socials a:hover {
    border-color: var(--line-strong);
    background: var(--bg);
    color: var(--ink);
  }

  .profile-card__cta {
    width: 100%;
  }

  /* Timeline -------------------------------------------------------------- */

  .timeline-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .timeline-intro {
    position: sticky;
    top: 6.5rem;
  }

  .timeline-intro h2 {
    margin-block: 1rem 1rem;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
  }

  .timeline-intro > p:last-child {
    color: var(--muted);
  }

  .timeline {
    border-top: 1px solid var(--line);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .timeline__label {
    padding-top: 0.2rem;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline__body h3 {
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }

  .timeline__body p {
    max-width: 36rem;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Pillars --------------------------------------------------------------- */

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .pillar:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  .pillar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .pillar__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--bg);
    color: var(--accent-text);
  }

  .pillar__index {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
  }

  .pillar h3 {
    font-size: 1.35rem;
  }

  .pillar p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Partners block -------------------------------------------------------- */

  .partners-block {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .partners-block__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .partners-block__head h3 {
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .partners-block__head span {
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .about-intro,
    .timeline-layout {
      grid-template-columns: 1fr;
    }

    .profile-card,
    .timeline-intro {
      position: static;
    }

    .profile-card {
      max-width: 28rem;
    }

    .pillars {
      grid-template-columns: 1fr;
    }

    .pillar {
      min-height: 0;
    }
  }

  @media (max-width: 560px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
